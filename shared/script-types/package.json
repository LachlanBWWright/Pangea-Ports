{
  "name": "@pangea-ports/script-types",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/pangea.d.ts",
      "default": "./dist/pangea.js"
    },
    "./games/bugdom2": {
      "types": "./dist/games/bugdom2.d.ts",
      "default": "./dist/games/bugdom2.js"
    },
    "./games": {
      "types": "./dist/games/index.d.ts",
      "default": "./dist/games/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:examples": "tsc -p tsconfig.examples.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit && tsx --test tests/examples.test.ts"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
